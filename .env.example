# Metabase Enterprise license/embedding token. Connection impersonation is an
# Enterprise feature and will not work without a valid token here.
# Get a trial/dev token from your Metabase contact or https://store.metabase.com
MB_PREMIUM_EMBEDDING_TOKEN=

# Ports on your host machine.
METABASE_PORT=3000
TRINO_PORT=8080

# Postgres (the sample data warehouse Trino queries — Metabase never connects
# to this directly, only through Trino).
POSTGRES_DB=sample
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Simple, shared credentials for this throwaway local stack. Not sensitive —
# everyone (admin, Leo, Mikey, Ralph, Donny) uses the same password.
ADMIN_EMAIL=admin@example.com
USER_PASSWORD=metabot1

LEO_EMAIL=leo@example.com
MIKEY_EMAIL=mikey@example.com
RALPH_EMAIL=ralph@example.com
DONNY_EMAIL=donny@example.com

# Admin automation API key, baked in at first boot via metabase-config/config.yml.
# Already a valid-looking key — no need to change it for local use.
MB_AUTOMATION_API_KEY=mb_local0000000000000000000000000000000000000
